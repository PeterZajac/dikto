{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-cancel-dictation",
    "allow-retry-transcription",
    "allow-set-groq-key",
    "allow-get-settings",
    "allow-set-settings",
    "allow-has-groq-key",
    "allow-test-groq-key",
    "allow-meridian-status",
    "allow-meridian-models",
    "allow-finish-wizard",
    "allow-history-list",
    "allow-history-delete",
    "allow-history-clear",
    "allow-history-retry",
    "allow-history-audio-path",
    "allow-history-export-audio",
    "allow-notes-list",
    "allow-notes-get",
    "allow-notes-create",
    "allow-notes-update",
    "allow-notes-delete",
    "allow-test-cleanup",
    "allow-permissions-status",
    "allow-open-privacy-settings",
    "allow-open-url",
    "allow-hotkey-capture-start",
    "autostart:default",
    "updater:default",
    "process:allow-restart"
  ]
}
